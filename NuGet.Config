<?xml version="1.0" encoding="utf-8"?>
<!--
  ClipBridge repository-local NuGet configuration.

  Scope: ONLY projects under this repository (NuGet merges config files found
  in the project/solution directory tree; this file does not affect other
  .NET projects on this machine).

  Why this file exists:
  - nuget.org is very slow on this network (common in CN), so a Huawei Cloud
    mirror is enabled for this repo to restore packages reliably.
  - In Milestone 1 the mirror was added to the USER-LEVEL config
    (%APPDATA%\NuGet\NuGet.Config), which affects EVERY .NET project on the
    machine. Milestone 2 moved it here (repo-local), and the user-level file
    was restored to its original nuget.org-only state. See docs/DEVELOPMENT.md.
  - The mirror is optional: on a fast network, removing the "huawei" line
    below and using nuget.org alone works the same way.

  <clear /> keeps this repository's source list deterministic: exactly the
  two sources below, regardless of any future user/machine-level sources.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="huawei" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
