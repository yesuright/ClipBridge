# Copy this file to `.env` and change the token.
# `.env` is gitignored — never commit real secrets.

# Bind address. Keep 127.0.0.1 for local development.
# For production over the Internet, deploy behind TLS (HTTPS) and bind 0.0.0.0.
CLIPBRIDGE_HOST=127.0.0.1
CLIPBRIDGE_PORT=8787

# Shared device token. Every client must send `Authorization: Bearer <this>`.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
CLIPBRIDGE_TOKEN=change-me-generate-a-random-hex-token

# SQLite database file (relative to services/relay/).
CLIPBRIDGE_DB_PATH=data/clipbridge.db

# Protocol limits.
CLIPBRIDGE_MAX_CONTENT_BYTES=2097152     # 2 MiB of UTF-8 text per clip
CLIPBRIDGE_MAX_BODY_BYTES=16777216       # JSON body guard (16 MiB, escape overhead)
CLIPBRIDGE_HISTORY_LIMIT=50              # keep the newest N clips
CLIPBRIDGE_DEDUP_WINDOW_SECONDS=15       # loop-defense window for identical re-posts

CLIPBRIDGE_LOG_LEVEL=INFO
CLIPBRIDGE_LOG_DIR=data/logs
